{
  "version": 2,
  "rewrites": [
    { "source": "/main", "destination": "/" },
    { "source": "/page77759756.html", "destination": "/book" },
    { "source": "/Contacts", "destination": "/#contacts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
